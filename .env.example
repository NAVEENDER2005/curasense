# --- Database ---
DATABASE_URL=postgresql+asyncpg://curasense:curasense@localhost:5432/curasense

# --- LLM providers ---
# Leave blank to run the AI layer in mock mode (rule-based scoring + templated
# text) so the app is fully demoable with zero API keys configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector store ---
# Leave PINECONE_API_KEY blank to use the built-in local vector store
# (cosine similarity over cached embeddings) instead of Pinecone.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=curasense-policies

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
